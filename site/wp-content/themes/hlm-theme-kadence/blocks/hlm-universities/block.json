          "imageUrl": "https://images.unsplash.com/photo-1562774053-701939374585?w=800&h=450&fit=crop",
          "imageAlt": "Berkeley College campus walkway",
          "meta": [
            { "icon": "location", "text": "4 Campuses + Online" },
            { "icon": "clock", "text": "90+ Years" }
          ]
        },
        {
          "badge": "Technology Focus",
          "title": "ECPI University",
