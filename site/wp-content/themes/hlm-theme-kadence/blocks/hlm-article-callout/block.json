{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/article-callout",
  "title": "Article Callout",
  "category": "hlm-blocks",
  "icon": "info",
  "description": "Help or CTA callout band for SEO blog articles.",
  "keywords": ["article", "blog", "callout", "cta", "help"],
  "supports": { "anchor": true, "html": false },
  "attributes": {
    "variant": { "type": "string", "default": "help" },
    "headline": { "type": "string", "default": "" },
    "paragraphs": { "type": "array", "default": [] },
    "body": { "type": "string", "default": "" }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
