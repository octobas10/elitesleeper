{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/article-checklist",
  "title": "Article Checklist",
  "category": "hlm-blocks",
  "icon": "yes-alt",
  "description": "Checklist section for SEO blog articles.",
  "keywords": ["article", "blog", "checklist", "fafsa"],
  "supports": { "anchor": true, "html": false },
  "attributes": {
    "headline": { "type": "string", "default": "" },
    "paragraphs": { "type": "array", "default": [] },
    "items": { "type": "array", "default": [] },
    "outro": { "type": "array", "default": [] }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
