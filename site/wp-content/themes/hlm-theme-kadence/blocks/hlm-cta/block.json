{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/cta",
  "title": "CTA Banner",
  "category": "hlm-blocks",
  "icon": "megaphone",
  "description": "Call-to-action banner with button.",
  "keywords": ["cta", "banner", "call to action"],
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "attributes": {
    "overline": { "type": "string", "default": "Ready to Connect?" },
    "headline": { "type": "string", "default": "Start Your Journey Today" },
    "description": { "type": "string", "default": "" },
    "primaryText": { "type": "string", "default": "Get Started" },
    "primaryUrl": { "type": "string", "default": "#form" },
    "secondaryText": { "type": "string", "default": "Learn More About Us" },
    "secondaryUrl": { "type": "string", "default": "/about-us/" },
    "variant": { "type": "string", "default": "brand" }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
