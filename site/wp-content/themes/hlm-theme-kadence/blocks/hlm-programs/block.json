{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/programs",
  "title": "Popular Programs",
  "category": "hlm-blocks",
  "icon": "book",
  "description": "Grid of program tags.",
  "keywords": ["programs", "degrees", "tags"],
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "attributes": {
    "overline": { "type": "string", "default": "Popular Programs" },
    "headline": { "type": "string", "default": "Programs Students Are Searching For" },
    "description": {
      "type": "string",
      "default": "From nursing to cybersecurity, business to criminal justice - find the program that matches your career goals."
    },
    "programs": {
      "type": "array",
      "default": [
        { "icon": "activity", "name": "Nursing (RN, BSN, MSN)" },
        { "icon": "monitor", "name": "Cybersecurity" },
        { "icon": "graduation", "name": "Business Administration" },
        { "icon": "document", "name": "Criminal Justice" },
        { "icon": "activity", "name": "Healthcare Management" },
        { "icon": "monitor", "name": "Software Development" },
        { "icon": "graduation", "name": "Marketing Communications" },
        { "icon": "document", "name": "Information Technology" }
      ]
    },
    "viewAllText": { "type": "string", "default": "View All Programs" },
    "viewAllUrl": { "type": "string", "default": "/contact-us/#form" }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
