{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/page-hero",
  "title": "Page Hero",
  "category": "hlm-blocks",
  "icon": "cover-image",
  "description": "Inner page hero banner with overline, headline, and description.",
  "keywords": ["hero", "banner", "page"],
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "attributes": {
    "overline": { "type": "string", "default": "Our Network" },
    "headline": { "type": "string", "default": "Strategic Partnerships\nThat Matter" },
    "description": { "type": "string", "default": "We collaborate with leading education organizations, technology platforms, and industry groups to deliver unmatched reach and results." },
    "mediaType": { "type": "string", "default": "image" },
    "mediaImageUrl": {
      "type": "string",
      "default": "https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1920&h=800&fit=crop"
    },
    "mediaImageId": { "type": "number", "default": 0 },
    "mediaImageAlt": { "type": "string", "default": "Team collaborating on education marketing" },
    "mediaVideoUrl": { "type": "string", "default": "" },
    "mediaPosterUrl": { "type": "string", "default": "" },
    "mediaPlaceholderLabel": { "type": "string", "default": "University Campus Video" },
    "mediaShowOverlay": { "type": "boolean", "default": true },
    "mediaOverlayStrength": { "type": "string", "default": "medium" },
    "primaryCtaText": { "type": "string", "default": "" },
    "primaryCtaUrl": { "type": "string", "default": "/contact-us/#form" }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
