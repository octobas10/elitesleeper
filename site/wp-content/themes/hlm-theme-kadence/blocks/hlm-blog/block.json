{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/blog",
  "title": "Blog Posts",
  "category": "hlm-blocks",
  "icon": "admin-post",
  "description": "Latest blog posts grid with link to the blog archive.",
  "keywords": ["blog", "posts", "news", "articles"],
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "attributes": {
    "overline": { "type": "string", "default": "Latest Insights" },
    "headline": { "type": "string", "default": "From Our Blog" },
    "description": { "type": "string", "default": "Tips, trends, and guidance for students and education marketers." },
    "postCount": { "type": "number", "default": 3 },
    "viewAllText": { "type": "string", "default": "View All Articles" },
    "viewAllUrl": { "type": "string", "default": "/blog/" }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
