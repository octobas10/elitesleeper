{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/process",
  "title": "Process Steps",
  "category": "hlm-blocks",
  "icon": "list-view",
  "description": "Step-by-step process strip.",
  "keywords": ["process", "steps", "workflow"],
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "attributes": {
    "layoutMode": { "type": "string", "default": "steps", "enum": ["steps", "blocks"] },
    "overline": { "type": "string", "default": "How It Works" },
    "headline": { "type": "string", "default": "Three Simple Steps" },
    "description": {
      "type": "string",
      "default": "Whether you are a student or institution, getting started takes just minutes."
    },
    "variant": { "type": "string", "default": "home" },
    "footerCtaText": { "type": "string", "default": "" },
    "footerCtaUrl": { "type": "string", "default": "#form" },
    "steps": {
      "type": "array",
      "default": [
        {
          "number": "01",
          "icon": "document",
          "title": "Submit Your Info",
          "description": "Fill out our simple form with your details, preferences, and goals. Takes less than 2 minutes.",
          "ctaText": "Start the Form",
          "ctaUrl": "#form"
        },
        {
          "number": "02",
          "icon": "info",
          "title": "Get Matched",
          "description": "Our system connects you with the best-fit programs or partnership opportunities based on your profile.",
          "ctaText": "Browse Programs",
          "ctaUrl": "#programs"
        },
        {
          "number": "03",
          "icon": "check",
          "title": "Start Your Journey",
          "description": "Connect directly with admissions teams or our partnership specialists to move forward.",
          "ctaText": "Get Started",
          "ctaUrl": "#form"
        }
      ]
    }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
