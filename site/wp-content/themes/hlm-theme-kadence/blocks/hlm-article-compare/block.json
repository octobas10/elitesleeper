{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/article-compare",
  "title": "Article Compare",
  "category": "hlm-blocks",
  "icon": "columns",
  "description": "Two-column comparison for SEO blog articles.",
  "keywords": ["article", "blog", "compare", "columns"],
  "supports": { "anchor": true, "html": false },
  "attributes": {
    "headline": { "type": "string", "default": "" },
    "leftTitle": { "type": "string", "default": "" },
    "rightTitle": { "type": "string", "default": "" },
    "leftParagraphs": { "type": "array", "default": [] },
    "rightParagraphs": { "type": "array", "default": [] },
    "footnote": { "type": "array", "default": [] }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
