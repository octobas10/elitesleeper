{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/stats",
  "title": "Stats Bar",
  "category": "hlm-blocks",
  "icon": "chart-bar",
  "description": "Animated statistics bar or network stats section.",
  "keywords": ["stats", "numbers", "counter"],
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "attributes": {
    "variant": { "type": "string", "default": "bar" },
    "overline": { "type": "string", "default": "Our Reach" },
    "headline": { "type": "string", "default": "Network By The Numbers" },
    "description": { "type": "string", "default": "The scale of our partner ecosystem and the impact it creates." },
    "stats": {
      "type": "array",
      "default": [
        { "number": 164, "prefix": "", "suffix": "+", "label": "Countries Reached" },
        { "number": 560, "prefix": "", "suffix": "+", "label": "Partner Websites" },
        { "number": 10, "prefix": "", "suffix": "M+", "label": "Leads Generated" },
        { "number": 98, "prefix": "", "suffix": "%", "label": "Client Satisfaction" }
      ]
    }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
