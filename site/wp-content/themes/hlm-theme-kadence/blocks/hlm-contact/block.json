{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlm/contact",
  "title": "Contact Details",
  "category": "hlm-blocks",
  "icon": "email",
  "description": "Contact information block.",
  "keywords": ["contact", "email", "phone"],
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "attributes": {
    "variant": { "type": "string", "default": "cards" },
    "overline": { "type": "string", "default": "Get In Touch" },
    "headline": { "type": "string", "default": "Contact Us" },
    "description": { "type": "string", "default": "" },
    "formHeadline": { "type": "string", "default": "Start Your Inquiry" },
    "responseNote": { "type": "string", "default": "We respond within one business day." },
    "hours": { "type": "string", "default": "Monday – Friday, 9:00 AM – 6:00 PM ET" },
    "email": { "type": "string", "default": "support@higherlearningmarketers.com" },
    "phone": { "type": "string", "default": "+1 (718) 655-2573" },
    "address": { "type": "string", "default": "138-07 82nd Drive\nBriarwood, NY 11435" }
  },
  "textdomain": "hlm-kadence",
  "editorScript": "hlm-blocks-editor",
  "render": "file:./render.php"
}
