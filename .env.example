# Public site (Stripe success/cancel URLs + canonical links)
SITE_URL=https://elitesleeper.com

# Stripe (server only — never commit real keys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional. Checkout does not need this on the client today.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# NMI / Collect (never commit real keys)
# Private Payment API key — server only. Used by Three-Step Redirect.
NMI_API_KEY=
# Override if your merchant portal lists a branded gateway domain.
NMI_GATEWAY_URL=https://midkingzllc.transactiongateway.com/api/v2/three-step
# Public Collect Checkout key — browser-safe. Not required for Three-Step.
NEXT_PUBLIC_NMI_CHECKOUT_PUBLIC_KEY=
NEXT_PUBLIC_NMI_CHECKOUT_SKU=0001

# Desk notifications (optional)
LEAD_NOTIFY_EMAIL=support@elitesleeper.com
LEAD_NOTIFY_FROM=Elite Sleeper <support@elitesleeper.com>
LEAD_WEBHOOK_URL=
RESEND_API_KEY=

# Orders/leads JSON storage (defaults to ./data/leads)
LEAD_STORAGE_DIR=

# Rate limit for /api/checkout and /api/leads
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_SEC=900
